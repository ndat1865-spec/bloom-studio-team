# Chep thanh .env truoc khi chay: cp .env.example .env
# .env KHONG duoc commit (da nam trong .gitignore).

# Mat khau root cua ca ba container MySQL.
DB_PASSWORD=doi-mat-khau-nay

# Phai giong het o ca ba service backend. De trong thi moi service dung mac dinh
# trong application.properties — van chay duoc nhung khong nen dung that.
JWT_SECRET=Bloom-Studio-Secret-Key-Do-An-Huong-Dich-Vu-2026-Doi-Trong-Thuc-Te

# So giay Gateway nho ket qua kiem tra API Key. Dat 0 khi can trinh bay canh
# thu hoi khoa co hieu luc ngay.
PARTNER_KEY_CACHE_TTL=60
